# Supabase project credentials.
#
# Copy this file to `.env.local` and fill in the values from your project's
# API settings. `.env.local` is git-ignored and must stay that way.
#
# Both values are baked into the browser bundle at build time, so neither may
# be a secret. The publishable (anon) key is safe there only because
# row-level security stands behind it. Never put the service-role key here.
#
# See docs/supabase-setup.md.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Needed only by the one-off seed script (`npm run seed`), never by the app.
#
# This key bypasses row-level security, so it is a real secret. It must NOT
# carry a VITE_ prefix — anything VITE_-prefixed is compiled into the browser
# bundle for anyone to read. Take it from Project Settings -> API -> service_role.
#
# Delete it again once the collection is seeded.

SUPABASE_SERVICE_ROLE_KEY=
